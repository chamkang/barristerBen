# =============================================================================
# FONJU & PARTNERS LAW FIRM — APACHE / LITESPEED CONFIGURATION
# Works as-is on Namecheap (LiteSpeed), any Apache/cPanel host and XAMPP,
# including from a sub-folder such as http://localhost/barrister-Ben/.
# =============================================================================

DirectoryIndex index.php index.html
Options -Indexes -MultiViews

# -----------------------------------------------------------------------------
# Custom error page
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------------------------------------------------------------------------
  # 1. One address for the live site: https://fonjulawfirm.com (no "www").
  #    Limited to the real domain so local copies are never redirected.
  # ---------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^(www\.)?fonjulawfirm\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://fonjulawfirm.com%{REQUEST_URI} [R=301,L,NE]

  # ---------------------------------------------------------------------------
  # 2. Never serve source, content files, settings or tooling directly.
  # ---------------------------------------------------------------------------
  RewriteRule ^(includes|storage|tools|content|dist|node_modules|\.github|\.claude)(/|$) - [R=404,L]
  RewriteRule ^api/_ - [R=404,L]
  # Hidden files and folders (.git, .env…), except .well-known for SSL renewals.
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

  # ---------------------------------------------------------------------------
  # 3. Old ".php" addresses -> clean addresses (301, so search engines and
  #    old links follow). Only GET requests, so form posts are never lost.
  # ---------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} ^GET\s(/[^\s?]*?)practice-area\.php\?area=([a-z0-9-]+)[\s&] [NC]
  RewriteRule ^ %1practice/%2? [R=301,L,NE]

  RewriteCond %{THE_REQUEST} ^GET\s(/[^\s?]*?)post\.php\?p=([a-z0-9-]+)[\s&] [NC]
  RewriteRule ^ %1insights/%2? [R=301,L,NE]

  RewriteCond %{THE_REQUEST} ^GET\s(/[^\s?]*?)(sitemap|feed)\.php[\s?] [NC]
  RewriteRule ^ %1%2.xml [R=301,L,NE]

  RewriteCond %{THE_REQUEST} ^GET\s(/[^\s?]*?)llms\.php[\s?] [NC]
  RewriteRule ^ %1llms.txt [R=301,L,NE]

  RewriteCond %{THE_REQUEST} ^GET\s(/[^\s?]*?)index\.php[\s?] [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # Never for the editor API or the blocked folders (LiteSpeed would otherwise
  # redirect /includes/x.php before answering 404).
  RewriteCond %{THE_REQUEST} !/(api|includes|storage|tools|content|dist|node_modules)/ [NC]
  RewriteCond %{THE_REQUEST} ^GET\s(/[^\s?]*?)([a-z0-9-]+)\.php[\s?] [NC]
  RewriteRule ^ %1%2 [R=301,L,NE]

  # ---------------------------------------------------------------------------
  # 4. Clean addresses -> the PHP scripts that render them.
  # ---------------------------------------------------------------------------
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^feed\.xml$ feed.php [L]
  RewriteRule ^llms\.txt$ llms.php [L]

  # The article editor's API: /api/session -> api/session.php
  RewriteRule ^api/([a-z]+)$ api/$1.php [L]

  RewriteRule ^(fr/)?practice/([a-z0-9-]+)/?$ $1practice-area.php?area=$2 [L,QSA]
  RewriteRule ^(fr/)?insights/([a-z0-9-]+)/?$ $1post.php?p=$2 [L,QSA]

  # /about -> about.php, /fr/faq -> fr/faq.php
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# -----------------------------------------------------------------------------
# Compression — significantly reduces page weight over slow connections
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Browser caching for static assets
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/xml         "access plus 1 hour"
  ExpiresByType application/rss+xml     "access plus 1 hour"
</IfModule>

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Enable once the site is served over HTTPS everywhere:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# -----------------------------------------------------------------------------
# Do not serve internal files
# -----------------------------------------------------------------------------
<FilesMatch "^(\.htaccess|\.htpasswd|\.ftp-deploy-sync-state\.json|composer\.(json|lock)|README\.md|build\.php|vercel\.json|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

# The folders above are also blocked by the rewrite rules; this is the
# fallback for a server without mod_rewrite.
RedirectMatch 404 ^/(storage|tools|includes|content|dist)/
